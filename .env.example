# Copie este arquivo para .env e preencha os valores reais
# Exemplo de uso:
# cp .env.example .env

# ==================== SEGURANÇA ====================
# Chave secreta para Flask (altere para algo único e seguro)
SECRET_KEY=sua_chave_secreta_muito_segura_aqui

# ==================== BANCO DE DADOS ====================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=bd_ss
DB_PORT=3306

# ==================== EMAIL (SMTP) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu_email@gmail.com
SMTP_PASSWORD=sua_app_password_google
SMTP_FROM=seu_email@gmail.com
ADMIN_EMAIL=admin@empresa.com

# ==================== HTTPS / SSL ====================
# Modo SSL: auto (detecta automaticamente), adhoc (sem arquivo), custom (arquivo)
SSL_MODE=auto

# Desabilitar SSL completamente (apenas para desenvolvimento)
DISABLE_SSL=false

# Usar SSL ad-hoc sem arquivos (requer pyopenssl)
USE_ADHOC_SSL=false

# ==================== APLICAÇÃO ====================
APP_BASE_URL=https://localhost:8080
FLASK_DEBUG=true
